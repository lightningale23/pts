-// "5.46" for display.
-export const formatDifficulty = d => (typeof d === 'number' ? d.toFixed(2) : '');
+// "3.5" for a question, "4.81" for a set's or round's average.
+export const formatDifficulty = (d, digits = 2) => (typeof d === 'number' ? d.toFixed(digits) : '');
+
+// What a number means (importer/difficulty/RUBRIC.md): the share of high school teams at an average
+// online invitational that would get the question, f = 10^(-d/5). "about 1 team in 10", "about 40% of teams".
+export function teamShare(d) {
+  const f = 10 ** (-d / 5);
+  if (f >= 0.2) return `about ${Math.round(f * 20) * 5}% of teams`;
+  const n = 1 / f;
+  const nice = n < 20 ? Math.round(n) : n < 100 ? Math.round(n / 5) * 5 : n < 1000 ? Math.round(n / 50) * 50 : Math.round(n / 500) * 500;
+  return `about 1 team in ${nice.toLocaleString()}`;
+}
+
+// Stored ratings (data/difficulty.csv: "id,d" lines) → Map(id → d).
+export function parseDifficultyCsv(text) {
+  const m = new Map();
+  for (const line of String(text || '').split('\n')) {
+    const [id, d] = line.split(',');
+    if (id && id !== 'id' && d !== undefined && d.trim() !== '' && !Number.isNaN(+d)) m.set(id.trim(), +d);
+  }
+  return m;
+}
 
 // A band name for a number (tooltips and screen readers).
 export function difficultyBand(d) {
   return d < 2 ? 'easy' : d < 4 ? 'standard' : d < 6 ? 'tough' : d < 8 ? 'hard' : d < 10 ? 'very hard' : 'extreme';
 }
 
-export const DIFFICULTY_NOTE = 'Difficulty from 0 (easiest) to 10 (hardest); the very hardest go past 10.';
+export const DIFFICULTY_NOTE = 'Difficulty: roughly how many teams at an online invitational would get it (5 is about 1 team in 10, 10 about 1 in 100).';
 
 // The gold difficulty number. what: 'question' | 'round' | 'set'.
 export function difficultyBadge(d, { what = 'question', extra = '' } = {}) {
   if (typeof d !== 'number') return null;
   const label = what === 'question' ? 'Difficulty' : `${what === 'set' ? 'Set' : 'Round'} difficulty`;
-  const text = `${label} ${formatDifficulty(d)}: ${difficultyBand(d)}${what === 'question' ? '' : ' (the average of its questions)'}.`;
-  return el('span', { class: 'diff', title: `${text} ${DIFFICULTY_NOTE}${extra ? ` ${extra}` : ''}`, 'aria-label': text }, formatDifficulty(d));
+  const digits = what === 'question' ? 1 : 2;
+  const text = what === 'question'
+    ? `${label} ${formatDifficulty(d, digits)}: ${teamShare(d)} would get it.`
+    : `${label} ${formatDifficulty(d, digits)} (the average of its questions).`;
+  return el('span', { class: 'diff', title: `${text} ${DIFFICULTY_NOTE}${extra ? ` ${extra}` : ''}`, 'aria-label': text }, formatDifficulty(d, digits));
 }
